NODE_ENV="development"
DATABASE_URL="postgresql://usuario:senha@localhost:5434/compras_corporativas"
# JWT_SECRET e API_KEY precisam ter pelo menos 32 caracteres (o app recusa
# subir com um valor mais curto) — gere algo aleatório em produção, ex:
# openssl rand -base64 32
JWT_SECRET="troque-esta-chave-em-producao-1234567890"
JWT_EXPIRES_IN="1d"
API_KEY="troque-esta-chave-de-api-em-producao-1234567890"
PORT=3000
CNPJ_API_BASE_URL="https://brasilapi.com.br/api/cnpj/v1"
CNPJ_API_TIMEOUT_MS=3000
# Origens (separadas por vírgula) autorizadas a chamar a API via CORS — o
# frontend em dev roda em localhost:5173. Em produção, aponte para o
# domínio real do frontend (nunca deixe em branco/"*" com um proxy exposto).
CORS_ORIGIN="http://localhost:5173"
